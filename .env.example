# Copier en .env et renseigner. Ne jamais committer .env.

# Clé maître MeiliSearch (16 caractères minimum) — ex. : openssl rand -hex 24
MEILI_MASTER_KEY=

# Jeton demandé sur la page /depot. Vide = dépôt via le web désactivé.
UPLOAD_TOKEN=

# Port HTTP exposé sur le serveur
HTTP_PORT=80

# Taille maximale d'un fichier déposé (Mo)
MAX_UPLOAD_MB=20

# Dossier EAD sur l'hôte (optionnel). Par défaut : volume Docker "ead_data".
# Utiliser un chemin pour pouvoir déposer des fichiers par SFTP/scp, ex. :
# EAD_DIR=/srv/calames/ead

# Recherche en langage naturel et résumés (optionnel, API compatible OpenAI)
NL_LLM_BASE_URL=
NL_LLM_API_KEY=
NL_LLM_MODEL=
