# Copier en .env et renseigner. Ne jamais committer .env.

# Clé maître MeiliSearch (16 caractères minimum) — ex. : openssl rand -hex 24
MEILI_MASTER_KEY=

# Jeton demandé sur la page /depot. Vide = dépôt via le web désactivé.
UPLOAD_TOKEN=

# Port HTTP exposé sur le serveur
HTTP_PORT=80

# Taille maximale d'un fichier déposé (Mo)
MAX_UPLOAD_MB=20

# Dossier EAD sur l'hôte (optionnel). Par défaut : volume Docker "ead_data".
# Utiliser un chemin pour pouvoir déposer des fichiers par SFTP/scp, ex. :
# EAD_DIR=/srv/calames/ead

# Moissonnage OAI-PMH (service "harvester", profil "harvest")
# Entrepôt (vide = Calames : https://calames.abes.fr/oai/oai2.aspx)
OAI_URL=
# setSpec à moissonner, séparés par des virgules (vide = tout l'entrepôt :
# ~3 700 instruments, 1,2 Go, plusieurs heures pour Calames)
HARVEST_SETS=
# Nombre max de notices par set (vide = pas de limite)
HARVEST_LIMIT=
# Pause entre deux requêtes OAI, en secondes (ménage le serveur source)
HARVEST_DELAY=2
# Périodicité des moissonnages incrémentaux en heures (0 = une seule passe)
HARVEST_EVERY_HOURS=24

# Recherche en langage naturel et résumés (optionnel, API compatible OpenAI)
NL_LLM_BASE_URL=
NL_LLM_API_KEY=
NL_LLM_MODEL=
