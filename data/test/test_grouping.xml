        <c id="self-2" level="item"><did><unittitle>Acte notarié</unittitle></did></c>
        <c id="self-3" level="item"><did><unittitle>Quittance</unittitle></did></c>
        <c id="self-4" level="item"><did><unittitle>Inventaire après décès</unittitle></did></c>
      </c>
      <c id="serie-vide" level="series">
        <did><unittitle>Série sans rapport</unittitle></did>
        <c id="vide-1" level="item"><did><unittitle>Registre de comptes</unittitle></did></c>
      </c>
    </dsc>
  </archdesc>
</ead>
