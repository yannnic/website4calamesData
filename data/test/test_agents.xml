<?xml version="1.0" encoding="UTF-8"?>
<!-- Teste : les noms de personnes, de collectivités et de familles du <controlaccess>
     vont chacun dans leur propre champ, sous leur forme normalisée (@normal), et
     s'accumulent d'un niveau à l'autre (héritage cumulatif).

     Structure :
       Fonds agents   persname « Martin, Paul » (@normal ; texte « Martin, Paul (1920-2000) »,
                      IdRef 123456789), corpname « Ministère de la Culture »,
                      famname « Famille Dupont »
       └── Série A    persname « Durand, Marie », famname « Famille Bernard »

     Attendu :
       Fonds   pers_names = Martin, Paul           (forme @normal, pas le texte)
               corp_names = Ministère de la Culture
               fam_names  = Famille Dupont         (pas dans pers_names)
               pers_name_ids contient « Martin, Paul||123456789 » (lien IdRef)
       Série A pers_names = Durand, Marie ; Martin, Paul       (propre + hérité)
               fam_names  = Famille Bernard ; Famille Dupont   (propre + hérité)
               corp_names = Ministère de la Culture            (hérité seulement)
-->
<ead>
  <eadheader><eadid>test-agents</eadid></eadheader>
  <archdesc level="fonds">
    <did>
      <unittitle>Fonds agents</unittitle>
      <unitdate normal="1900/2000">XXe siècle</unitdate>
    </did>
    <controlaccess>
      <persname normal="Martin, Paul" role="070" source="Sudoc" authfilenumber="123456789">Martin, Paul (1920-2000)</persname>
      <corpname normal="Ministère de la Culture">Ministère de la Culture</corpname>
      <famname normal="Famille Dupont">Famille Dupont</famname>
    </controlaccess>
    <dsc>
      <c id="serie-A" level="series">
        <did>
          <unittitle>Série A</unittitle>
          <unitdate normal="1950/1980">1950-1980</unitdate>
        </did>
        <controlaccess>
          <!-- personne propre à la série -->
          <persname normal="Durand, Marie">Durand, Marie</persname>
          <!-- famille propre à la série -->
          <famname normal="Famille Bernard">Famille Bernard</famname>
        </controlaccess>
      </c>
    </dsc>
  </archdesc>
</ead>
